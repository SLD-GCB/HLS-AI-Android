<?xml version="1.0" encoding="utf-8"?>
<!--
  关掉一切备份/迁移通道：本地数据（含加密后的密钥、角色、会话）不进云端备份、
  不参与换机迁移。要迁移就自己拷贝 酒馆数据 目录。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
